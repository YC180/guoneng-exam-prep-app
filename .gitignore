# ---------------------------------------------------------------- 依赖与缓存
# Python 库与各类缓存体积大、且可由脚本/工具重建，不入库
python-libs/
caches/
__pycache__/
*.pyc
.venv/
venv/

# 前端测试依赖（jsdom）
work/domtest/node_modules/
work/domtest/package-lock.json

# ---------------------------------------------------------------- 原始资料
# `原始资料/` 是指向厂商备考资料（约 1.76 GB、370 份 PDF/DOCX/PPT）的目录联接。
# **不纳入版本库**：①体积过大；②原始资料版权归原机构，公开仓库不宜再分发。
# 仓库保留的是**抽取后的文本/OCR 与结构化题库**（work/text*、work/ocr、work/bank），
# 足以复现题库构建；若需重跑原始提取，把资料放回该目录即可（见 README）。
原始资料/
*.pdf
*.PDF

# ---------------------------------------------------------------- 中间产物
work/_tmp*/
work/ocr/*.log
work/**/*.log

# Android 构建中间产物（由 android/build_apk.py 生成；签名密钥 keystore/ 需要入库，
# 以便后续版本能用同一签名覆盖安装）
android/build/
android/*.apk

# ---------------------------------------------------------------- 系统文件
Thumbs.db
desktop.ini
.DS_Store
